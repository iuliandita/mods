{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "timezone": "Etc/UTC",
  "schedule": [
    "* 6 * * 1"
  ],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "semanticCommitType": "deps",
      "semanticCommitScope": "ci"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "semanticCommitType": "deps",
      "semanticCommitScope": "dev"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        ".github/tools/markdownlint/**"
      ],
      "groupName": "markdownlint",
      "semanticCommitType": "deps",
      "semanticCommitScope": "ci"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        ".github/ci/claude-code/**"
      ],
      "groupName": "claude-code",
      "semanticCommitType": "deps",
      "semanticCommitScope": "ci"
    },
    {
      "matchManagers": [
        "npm",
        "bun"
      ],
      "matchFileNames": [
        ".github/tools/typecheck/**"
      ],
      "groupName": "typecheck",
      "semanticCommitType": "deps",
      "semanticCommitScope": "ci"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "semanticCommitType": "deps",
      "semanticCommitScope": "ci"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "zizmor binary version passed to zizmor-action",
      "managerFilePatterns": [
        "/^\\.github/workflows/security\\.yml$/"
      ],
      "matchStrings": [
        "uses: zizmorcore/zizmor-action@[^\\n]+\\n\\s+with:\\n\\s+version: \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "zizmorcore/zizmor",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
