#!/usr/bin/env python3
"""secret-box: keep secret values out of chat, argv, and transcripts."""
import base64
import copy
import getpass
import json
import os
import re
import subprocess
import sys
import threading
from concurrent.futures import ThreadPoolExecutor
from urllib.parse import quote

SERVICE = "claude-mods-secret-box"
NAME_RE = re.compile(r"[A-Za-z0-9._-]+")
PLACEHOLDER_RE = re.compile(r"\{\{secret:([A-Za-z0-9._-]+)\}\}")
MIN_SAFE_LEN = 6
MAX_LOOKUPS = 8
# Python's strip() trims other characters than JS trim(), so the JS set is spelled out.
JS_SPACE = (
    "\t\n\v\f\r \xa0            "
    "    　﻿"
)


class SecretBoxError(Exception):
    pass


def u16len(s):
    # The TS lengths count UTF-16 code units, so astral characters count twice.
    return len(s.encode("utf-16-le", "surrogatepass")) // 2


def _b64(b):
    return base64.b64encode(b).decode("ascii")


def _base64_forms(base):
    bs = base.encode("utf-8", "surrogatepass")
    whole = _b64(bs)
    out = [whole, whole.rstrip("=")]
    # The part of the base64 that stays the same when 0, 1 or 2 bytes come before the value.
    for k, start in enumerate((0, 2, 3)):
        out.append(_b64(bytes(k) + bs).rstrip("=")[start : (len(bs) + k) * 8 // 6])
    return out + [f.replace("+", "-").replace("/", "_") for f in out]


def _u_escape(c, fmt):
    b = c.encode("utf-16-le", "surrogatepass")
    return "".join(fmt % int.from_bytes(b[i : i + 2], "little") for i in range(0, len(b), 2))


def _lower_hex(s):
    return re.sub(r"%[0-9A-F]{2}", lambda m: m.group().lower(), s)


def forms(value):
    """Every encoding of a secret value to scrub; the same set as forms() in hooks/scrub.ts."""
    out = set()
    for base in {value, value.strip(JS_SPACE)}:
        if u16len(base) < MIN_SAFE_LEN:
            continue
        out.add(base)
        js = json.dumps(base, ensure_ascii=False)[1:-1]
        out.add(js)
        if any(ord(c) > 0x7F for c in js):
            for fmt in ("\\u%04x", "\\u%04X"):
                out.add("".join(c if ord(c) < 0x80 else _u_escape(c, fmt) for c in js))
        try:
            url = quote(base, safe="-_.!~*'()")  # same unreserved set as encodeURIComponent
        except UnicodeEncodeError:
            url = None  # a lone surrogate has no URL form
        if url is not None:
            strict = re.sub(r"[!'()*]", lambda m: "%%%02X" % ord(m.group()), url)
            for u in (url, strict):
                for f in (u, u.replace("%20", "+")):
                    out.add(f)
                    out.add(_lower_hex(f))
        out.update(_base64_forms(base))
    return list(out)


class Scrubber:
    """Replaces known secret values in a byte stream with {{secret:NAME}}, one pass, longest form first."""

    def __init__(self, pairs):
        by_form = {}
        for name, value in sorted(pairs, key=lambda p: p[0]):
            for f in forms(value):
                by_form.setdefault(f, name)  # the first name in sorted order wins a shared form
        # Same order as the TS sort: UTF-16 length descending, then UTF-16 code unit order.
        ordered = sorted(by_form, key=lambda f: (-u16len(f), f.encode("utf-16-be", "surrogatepass")))
        self.repl = {
            f.encode("utf-8", "surrogatepass"): b"{{secret:" + by_form[f].encode() + b"}}"
            for f in ordered
        }
        self.re = re.compile(b"|".join(re.escape(f) for f in self.repl)) if self.repl else None
        self.hold = max((len(f) for f in self.repl), default=1) - 1
        self.buf = b""

    def clone(self):
        c = copy.copy(self)
        c.buf = b""
        return c

    def feed(self, chunk):
        if self.re is None:
            return chunk
        buf = self.buf + chunk
        cut = len(buf) - self.hold
        if cut <= 0:
            self.buf = buf
            return b""
        # A match that starts before the cut has all its bytes in buf; one at or after it may still
        # grow, so it stays held with everything after it.
        out, pos = [], 0
        for m in self.re.finditer(buf):
            if m.start() >= cut:
                break
            out += [buf[pos : m.start()], self.repl[m.group()]]
            pos = m.end()
        if pos < cut:
            out.append(buf[pos:cut])
            pos = cut
        self.buf = buf[pos:]
        return b"".join(out)

    def flush(self):
        buf, self.buf = self.buf, b""
        return buf if self.re is None else self.re.sub(lambda m: self.repl[m.group()], buf)


def parse_names(text):
    # secret-tool search prints its attribute lines on stderr in some builds, stdout in others.
    return sorted({m.group(1) for m in re.finditer(r"^attribute\.name = (.*)$", text, re.M)})


class LibsecretBackend:
    def _run(self, args, stdin=None):
        try:
            return subprocess.run(
                ["secret-tool", *args], input=stdin, capture_output=True, text=True
            )
        except FileNotFoundError:
            raise SecretBoxError("secret-tool not found; install libsecret tools")

    def get(self, name):
        p = self._run(["lookup", "service", SERVICE, "name", name])
        if p.returncode == 0:
            return p.stdout
        if p.returncode == 1 and not p.stderr.strip():
            return None
        raise SecretBoxError(f"secret-tool lookup failed (exit {p.returncode})")

    def set(self, name, value):
        label = f"{SERVICE}: {name}"
        p = self._run(
            ["store", "--label", label, "service", SERVICE, "name", name], stdin=value
        )
        if p.returncode != 0:
            raise SecretBoxError(f"secret-tool store failed (exit {p.returncode})")

    def remove(self, name):
        p = self._run(["clear", "service", SERVICE, "name", name])
        if p.returncode != 0:
            raise SecretBoxError(f"secret-tool clear failed (exit {p.returncode})")

    def names(self):
        p = self._run(["search", "--all", "service", SERVICE])
        if p.returncode not in (0, 1) or (p.returncode == 1 and p.stderr.strip()):
            raise SecretBoxError(f"secret-tool search failed (exit {p.returncode})")
        return parse_names(p.stdout + "\n" + p.stderr)


class FileBackend:
    """Test-only JSON-file backend; refused unless SECRET_BOX_TEST=1."""

    def __init__(self, path):
        self.path = path

    def _load(self):
        try:
            with open(self.path) as f:
                return json.load(f)
        except FileNotFoundError:
            return {}

    def _save(self, data):
        with open(self.path, "w") as f:
            json.dump(data, f)

    def get(self, name):
        return self._load().get(name)

    def set(self, name, value):
        data = self._load()
        data[name] = value
        self._save(data)

    def remove(self, name):
        data = self._load()
        data.pop(name, None)
        self._save(data)

    def names(self):
        return sorted(self._load())


def get_backend():
    spec = os.environ.get("SECRET_BOX_BACKEND")
    if not spec:
        return LibsecretBackend()
    if os.environ.get("SECRET_BOX_TEST") != "1":
        raise SecretBoxError("SECRET_BOX_BACKEND is test-only and needs SECRET_BOX_TEST=1")
    if not spec.startswith("file:"):
        raise SecretBoxError("unknown SECRET_BOX_BACKEND")
    return FileBackend(spec[5:])


def rewrite(script):
    """Return (rewritten script, ordered distinct names)."""
    order = []

    def sub(m):
        name = m.group(1)
        if name not in order:
            order.append(name)
        return "${SECRET_BOX_%d}" % order.index(name)

    return PLACEHOLDER_RE.sub(sub, script), order


def single_quoted_placeholder(script):
    """Name of the first placeholder inside '...' or $'...', where bash would not expand it."""
    # A stack, so quotes inside $(...) or `...` nested in "..." are tracked: None is the top level,
    # "(" a subshell or command substitution, "`" a backtick substitution, or a quote.
    stack = [None]
    i = 0
    while i < len(script):
        c = script[i]
        top = stack[-1]
        if top in ("'", "$'"):
            m = PLACEHOLDER_RE.match(script, i)
            if m:
                return m.group(1)
            if c == "\\" and top == "$'":
                i += 1
            elif c == "'":
                stack.pop()
        elif c == "\\":
            i += 1
        elif c == "$" and script[i + 1 : i + 2] == "(":
            stack.append("(")
            i += 1
        elif c == "`":
            if top == "`":
                stack.pop()
            else:
                stack.append("`")
        elif top == '"':
            if c == '"':
                stack.pop()
        elif c == "'" or c == '"':
            stack.append(c)
        elif c == "$" and script[i + 1 : i + 2] == "'":
            stack.append("$'")
            i += 1
        elif c == "(":
            stack.append("(")
        elif c == ")":
            if top == "(":
                stack.pop()
        elif c == "#" and (i == 0 or script[i - 1] in " \t\n;&|()"):
            i = script.find("\n", i)
            if i < 0:
                break
        i += 1
    return None


def check_name(name):
    if not NAME_RE.fullmatch(name):
        raise SecretBoxError("invalid name; use letters, digits, '.', '_', '-'")


def cmd_set(backend, args):
    if len(args) != 1:
        raise SecretBoxError("usage: secret-box set NAME")
    name = args[0]
    check_name(name)
    if not sys.stdin.isatty():
        raise SecretBoxError("set needs a terminal; run it in an interactive shell")
    value = getpass.getpass(f"Value for {name} (hidden): ")
    if not value:
        raise SecretBoxError("empty value; nothing stored")
    if len(value) < MIN_SAFE_LEN:
        print(
            f"secret-box: warning: value is shorter than {MIN_SAFE_LEN} characters "
            "and will not be scrubbed from the session",
            file=sys.stderr,
        )
    backend.set(name, value)
    print(f"stored {name}")


def cmd_names(backend, args):
    if args not in ([], ["--json"]):
        raise SecretBoxError("usage: secret-box names [--json]")
    names = backend.names()
    if args:
        print(json.dumps(names))
    else:
        for n in names:
            print(n)


def cmd_remove(backend, args):
    if len(args) != 1:
        raise SecretBoxError("usage: secret-box remove NAME")
    check_name(args[0])
    backend.remove(args[0])


def stored_values(backend):
    names = backend.names()
    # Lookups run concurrently so many secrets fit the hook's 10 s timeout; map keeps the order and
    # re-raises the first failure in name order, as the sequential loop did.
    with ThreadPoolExecutor(max_workers=MAX_LOOKUPS) as pool:
        found = list(pool.map(backend.get, names))
    return {n: v for n, v in zip(names, found) if v is not None}


def cmd_values(backend, args):
    if args:
        raise SecretBoxError("usage: secret-box values")
    print(json.dumps(stored_values(backend)))


def pump(fd, dst, scrubber):
    # Keeps draining after a write error so the child never blocks on a full pipe.
    def write(data):
        nonlocal dst
        if data and dst is not None:
            try:
                dst.write(data)
                dst.flush()
            except OSError:
                dst = None

    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        write(scrubber.feed(chunk))
    write(scrubber.flush())


def run_scrubbed(backend, script, env):
    try:
        scrubber = Scrubber(stored_values(backend).items())
    except Exception:  # never echo the cause, it may carry a value
        print(
            "secret-box: could not load the stored secrets, so the command was not run (fail closed)",
            file=sys.stderr,
        )
        return 5
    proc = subprocess.Popen(
        ["bash", "-c", script], env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )
    threads = [
        threading.Thread(target=pump, args=(f.fileno(), dst, scrubber.clone()))
        for f, dst in ((proc.stdout, sys.stdout.buffer), (proc.stderr, sys.stderr.buffer))
    ]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    rc = proc.wait()
    return 128 - rc if rc < 0 else rc


def cmd_exec(backend, args):
    scrub = args[:1] == ["--scrub"]
    if scrub:
        args = args[1:]
    if len(args) != 2 or args[0] != "--":
        raise SecretBoxError("usage: secret-box exec [--scrub] -- SCRIPT")
    quoted = single_quoted_placeholder(args[1])
    if quoted:
        print(
            f"secret-box: placeholder {{{{secret:{quoted}}}}} is inside single quotes "
            "and would not expand; use double quotes",
            file=sys.stderr,
        )
        return 4
    script, order = rewrite(args[1])
    env = dict(os.environ)
    for i, name in enumerate(order):
        value = backend.get(name)
        if value is None:
            print(
                f"secret-box: secret {name} is not set; "
                f"run `secret-box set {name}` in a terminal",
                file=sys.stderr,
            )
            return 3
        env[f"SECRET_BOX_{i}"] = value
    if scrub:
        return run_scrubbed(backend, script, env)
    os.execvpe("bash", ["bash", "-c", script], env)


COMMANDS = {
    "set": cmd_set,
    "names": cmd_names,
    "remove": cmd_remove,
    "values": cmd_values,
    "exec": cmd_exec,
}


def main(argv):
    if not argv or argv[0] not in COMMANDS:
        print("usage: secret-box {set|names|remove|values|exec} ...", file=sys.stderr)
        return 2
    try:
        return COMMANDS[argv[0]](get_backend(), argv[1:]) or 0
    except SecretBoxError as e:
        print(f"secret-box: {e}", file=sys.stderr)
        return 1
    except Exception as e:  # fail closed, never echo values
        print(f"secret-box: internal error: {type(e).__name__}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
