#!/usr/bin/env python3
"""secret-box: keep secret values out of chat, argv, and transcripts."""
import getpass
import json
import os
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

SERVICE = "claude-mods-secret-box"
NAME_RE = re.compile(r"[A-Za-z0-9._-]+")
PLACEHOLDER_RE = re.compile(r"\{\{secret:([A-Za-z0-9._-]+)\}\}")
MIN_SAFE_LEN = 6
MAX_LOOKUPS = 8


class SecretBoxError(Exception):
    pass


def parse_names(text):
    # secret-tool search prints its attribute lines on stderr in some builds, stdout in others.
    return sorted({m.group(1) for m in re.finditer(r"^attribute\.name = (.*)$", text, re.M)})


class LibsecretBackend:
    def _run(self, args, stdin=None):
        try:
            return subprocess.run(
                ["secret-tool", *args], input=stdin, capture_output=True, text=True
            )
        except FileNotFoundError:
            raise SecretBoxError("secret-tool not found; install libsecret tools")

    def get(self, name):
        p = self._run(["lookup", "service", SERVICE, "name", name])
        if p.returncode == 0:
            return p.stdout
        if p.returncode == 1 and not p.stderr.strip():
            return None
        raise SecretBoxError(f"secret-tool lookup failed (exit {p.returncode})")

    def set(self, name, value):
        label = f"{SERVICE}: {name}"
        p = self._run(
            ["store", "--label", label, "service", SERVICE, "name", name], stdin=value
        )
        if p.returncode != 0:
            raise SecretBoxError(f"secret-tool store failed (exit {p.returncode})")

    def remove(self, name):
        p = self._run(["clear", "service", SERVICE, "name", name])
        if p.returncode != 0:
            raise SecretBoxError(f"secret-tool clear failed (exit {p.returncode})")

    def names(self):
        p = self._run(["search", "--all", "service", SERVICE])
        if p.returncode not in (0, 1) or (p.returncode == 1 and p.stderr.strip()):
            raise SecretBoxError(f"secret-tool search failed (exit {p.returncode})")
        return parse_names(p.stdout + "\n" + p.stderr)


class FileBackend:
    """Test-only JSON-file backend; refused unless SECRET_BOX_TEST=1."""

    def __init__(self, path):
        self.path = path

    def _load(self):
        try:
            with open(self.path) as f:
                return json.load(f)
        except FileNotFoundError:
            return {}

    def _save(self, data):
        with open(self.path, "w") as f:
            json.dump(data, f)

    def get(self, name):
        return self._load().get(name)

    def set(self, name, value):
        data = self._load()
        data[name] = value
        self._save(data)

    def remove(self, name):
        data = self._load()
        data.pop(name, None)
        self._save(data)

    def names(self):
        return sorted(self._load())


def get_backend():
    spec = os.environ.get("SECRET_BOX_BACKEND")
    if not spec:
        return LibsecretBackend()
    if os.environ.get("SECRET_BOX_TEST") != "1":
        raise SecretBoxError("SECRET_BOX_BACKEND is test-only and needs SECRET_BOX_TEST=1")
    if not spec.startswith("file:"):
        raise SecretBoxError("unknown SECRET_BOX_BACKEND")
    return FileBackend(spec[5:])


def rewrite(script):
    """Return (rewritten script, ordered distinct names)."""
    order = []

    def sub(m):
        name = m.group(1)
        if name not in order:
            order.append(name)
        return "${SECRET_BOX_%d}" % order.index(name)

    return PLACEHOLDER_RE.sub(sub, script), order


def single_quoted_placeholder(script):
    """Name of the first placeholder inside '...' or $'...', where bash would not expand it."""
    # A stack, so quotes inside $(...) or `...` nested in "..." are tracked: None is the top level,
    # "(" a subshell or command substitution, "`" a backtick substitution, or a quote.
    stack = [None]
    i = 0
    while i < len(script):
        c = script[i]
        top = stack[-1]
        if top in ("'", "$'"):
            m = PLACEHOLDER_RE.match(script, i)
            if m:
                return m.group(1)
            if c == "\\" and top == "$'":
                i += 1
            elif c == "'":
                stack.pop()
        elif c == "\\":
            i += 1
        elif c == "$" and script[i + 1 : i + 2] == "(":
            stack.append("(")
            i += 1
        elif c == "`":
            if top == "`":
                stack.pop()
            else:
                stack.append("`")
        elif top == '"':
            if c == '"':
                stack.pop()
        elif c == "'" or c == '"':
            stack.append(c)
        elif c == "$" and script[i + 1 : i + 2] == "'":
            stack.append("$'")
            i += 1
        elif c == "(":
            stack.append("(")
        elif c == ")":
            if top == "(":
                stack.pop()
        elif c == "#" and (i == 0 or script[i - 1] in " \t\n;&|()"):
            i = script.find("\n", i)
            if i < 0:
                break
        i += 1
    return None


def check_name(name):
    if not NAME_RE.fullmatch(name):
        raise SecretBoxError("invalid name; use letters, digits, '.', '_', '-'")


def cmd_set(backend, args):
    if len(args) != 1:
        raise SecretBoxError("usage: secret-box set NAME")
    name = args[0]
    check_name(name)
    if not sys.stdin.isatty():
        raise SecretBoxError("set needs a terminal; run it in an interactive shell")
    value = getpass.getpass(f"Value for {name} (hidden): ")
    if not value:
        raise SecretBoxError("empty value; nothing stored")
    if len(value) < MIN_SAFE_LEN:
        print(
            f"secret-box: warning: value is shorter than {MIN_SAFE_LEN} characters "
            "and will not be scrubbed from the session",
            file=sys.stderr,
        )
    backend.set(name, value)
    print(f"stored {name}")


def cmd_names(backend, args):
    if args not in ([], ["--json"]):
        raise SecretBoxError("usage: secret-box names [--json]")
    names = backend.names()
    if args:
        print(json.dumps(names))
    else:
        for n in names:
            print(n)


def cmd_remove(backend, args):
    if len(args) != 1:
        raise SecretBoxError("usage: secret-box remove NAME")
    check_name(args[0])
    backend.remove(args[0])


def cmd_values(backend, args):
    if args:
        raise SecretBoxError("usage: secret-box values")
    names = backend.names()
    # Lookups run concurrently so many secrets fit the hook's 10 s timeout; map keeps the order and
    # re-raises the first failure in name order, as the sequential loop did.
    with ThreadPoolExecutor(max_workers=MAX_LOOKUPS) as pool:
        found = list(pool.map(backend.get, names))
    print(json.dumps({n: v for n, v in zip(names, found) if v is not None}))


def cmd_exec(backend, args):
    if len(args) != 2 or args[0] != "--":
        raise SecretBoxError("usage: secret-box exec -- SCRIPT")
    quoted = single_quoted_placeholder(args[1])
    if quoted:
        print(
            f"secret-box: placeholder {{{{secret:{quoted}}}}} is inside single quotes "
            "and would not expand; use double quotes",
            file=sys.stderr,
        )
        return 4
    script, order = rewrite(args[1])
    env = dict(os.environ)
    for i, name in enumerate(order):
        value = backend.get(name)
        if value is None:
            print(
                f"secret-box: secret {name} is not set; "
                f"run `secret-box set {name}` in a terminal",
                file=sys.stderr,
            )
            return 3
        env[f"SECRET_BOX_{i}"] = value
    os.execvpe("bash", ["bash", "-c", script], env)


COMMANDS = {
    "set": cmd_set,
    "names": cmd_names,
    "remove": cmd_remove,
    "values": cmd_values,
    "exec": cmd_exec,
}


def main(argv):
    if not argv or argv[0] not in COMMANDS:
        print("usage: secret-box {set|names|remove|values|exec} ...", file=sys.stderr)
        return 2
    try:
        return COMMANDS[argv[0]](get_backend(), argv[1:]) or 0
    except SecretBoxError as e:
        print(f"secret-box: {e}", file=sys.stderr)
        return 1
    except Exception as e:  # fail closed, never echo values
        print(f"secret-box: internal error: {type(e).__name__}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
